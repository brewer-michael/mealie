<?xml version="1.0"?>
<Container version="2">
  <Name>mealie-dev</Name>
  <Repository>brewermichael/mealie-dev</Repository>
  <Registry>https://hub.docker.com/r/brewermichael/mealie-dev</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mealie-recipes/mealie</Support>
  <Project>https://github.com/brewer-michael/mealie</Project>
  <Overview>Mealie Development Build with Enhanced Image Scanning and OCR Support

This is a DEVELOPMENT version of Mealie with enhanced image scanning capabilities including:
- OCR support for handwritten recipe cards (Tesseract)  
- Multi-provider AI image scanning (OpenAI, Gemini, Anthropic, Ollama)
- Intelligent fallback chain: Primary AI → Secondary AI → OCR
- Support for HEIC/MPO image formats from iPhone
- Enhanced admin configuration interface

⚠️  DEVELOPMENT VERSION - Use for testing only!

Configure your AI providers and OCR settings at /admin/recipe-scanning

Default admin credentials: admin@example.com / MyPassword</Overview>
  <Category>Productivity:Dev</Category>
  <WebUI>http://[IP]:[PORT:9000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/brewer-michael/mealie/add-ocr-recipe/mealie-dev.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/mealiev1.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  
  <!-- Core Configuration -->
  <Config Name="WebUI Port" Target="9000" Default="9000" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="App Data" Target="/app/data" Default="/mnt/user/appdata/mealie-dev" Mode="rw" Description="Container data directory" Type="Path" Display="always" Required="true" Mask="false"/>
  
  <!-- Basic Settings -->
  <Config Name="ALLOW_SIGNUP" Target="ALLOW_SIGNUP" Default="false" Mode="" Description="Allow new user registration" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="DEFAULT_EMAIL" Target="DEFAULT_EMAIL" Default="admin@example.com" Mode="" Description="Default admin email address" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="BASE_URL" Target="BASE_URL" Default="" Mode="" Description="Base URL for reverse proxy (optional)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="DEFAULT_GROUP" Target="DEFAULT_GROUP" Default="home" Mode="" Description="Default group name" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  
  <!-- Email Configuration -->
  <Config Name="SMTP_HOST" Target="SMTP_HOST" Default="" Mode="" Description="SMTP server hostname" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="SMTP_PORT" Target="SMTP_PORT" Default="587" Mode="" Description="SMTP server port" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="SMTP_FROM_EMAIL" Target="SMTP_FROM_EMAIL" Default="" Mode="" Description="From email address" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="SMTP_USER" Target="SMTP_USER" Default="" Mode="" Description="SMTP username" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="SMTP_PASSWORD" Target="SMTP_PASSWORD" Default="" Mode="" Description="SMTP password" Type="Variable" Display="always" Required="false" Mask="true"/>
  
  <!-- Database Configuration -->
  <Config Name="DB_ENGINE" Target="DB_ENGINE" Default="sqlite" Mode="" Description="Database engine (sqlite or postgres)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="POSTGRES_USER" Target="POSTGRES_USER" Default="" Mode="" Description="PostgreSQL username" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="POSTGRES_PASSWORD" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="PostgreSQL password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="POSTGRES_SERVER" Target="POSTGRES_SERVER" Default="" Mode="" Description="PostgreSQL server hostname" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="POSTGRES_PORT" Target="POSTGRES_PORT" Default="5432" Mode="" Description="PostgreSQL server port" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="POSTGRES_DB" Target="POSTGRES_DB" Default="" Mode="" Description="PostgreSQL database name" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  
  <!-- Image Scanning Configuration -->
  <Config Name="IMAGE_SCANNING_PRIMARY_PROVIDER" Target="IMAGE_SCANNING_PRIMARY_PROVIDER" Default="openai" Mode="" Description="Primary AI provider: openai, gemini, anthropic, ollama, or none" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="IMAGE_SCANNING_SECONDARY_PROVIDER" Target="IMAGE_SCANNING_SECONDARY_PROVIDER" Default="none" Mode="" Description="Secondary AI provider for fallback: openai, gemini, anthropic, ollama, or none" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="IMAGE_SCANNING_ENABLE_OCR_FALLBACK" Target="IMAGE_SCANNING_ENABLE_OCR_FALLBACK" Default="true" Mode="" Description="Enable OCR fallback when AI providers fail" Type="Variable" Display="always" Required="false" Mask="false"/>
  
  <!-- API Keys -->
  <Config Name="OPENAI_API_KEY" Target="OPENAI_API_KEY" Default="" Mode="" Description="OpenAI API Key for GPT-4 Vision" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="GEMINI_API_KEY" Target="GEMINI_API_KEY" Default="" Mode="" Description="Google Gemini API Key for Vision" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="ANTHROPIC_API_KEY" Target="ANTHROPIC_API_KEY" Default="" Mode="" Description="Anthropic Claude API Key for Vision" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="OLLAMA_BASE_URL" Target="OLLAMA_BASE_URL" Default="http://localhost:11434" Mode="" Description="Ollama server URL for local AI models" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  
  <!-- System Configuration -->
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID for file permissions" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID for file permissions" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="WEB_CONCURRENCY" Target="WEB_CONCURRENCY" Default="1" Mode="" Description="Number of worker processes" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="MAX_WORKERS" Target="MAX_WORKERS" Default="1" Mode="" Description="Maximum number of workers" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>